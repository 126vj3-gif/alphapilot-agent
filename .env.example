# ── AlphaPilot configuration ────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit the real .env file.

# Binance API credentials (required only for LIVE / account-aware modes).
# Create a dedicated API key with SPOT trading permission only,
# NO withdrawal permission, and IP-whitelist it if possible.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# API environment: testnet | demo | prod  (default: testnet)
# testnet → https://testnet.binance.vision  (safe, fake funds)
BINANCE_API_ENV=testnet

# ── Agent runtime ───────────────────────────────────────────────────────────
# true  → simulate orders locally, never touch the exchange (default)
# false → place REAL orders on the selected environment
DRY_RUN=true

# Emergency stop: set to 1 to make the agent refuse every new order
KILL_SWITCH=0

# ── Strategy & risk (defaults shown; override freely) ───────────────────────
SYMBOL=BTCUSDT
INTERVAL=1h
STRATEGY=ensemble

# fraction of quote balance per entry (0.10 = 10%)
RISK__MAX_POSITION_PCT=0.10
# hard daily loss limit as fraction of day-start equity (0.03 = 3%)
RISK__MAX_DAILY_LOSS_PCT=0.03
RISK__MAX_DAILY_TRADES=20
RISK__STOP_LOSS_PCT=0.02
RISK__TAKE_PROFIT_PCT=0.04
# minutes the agent must wait between entries on the same symbol
RISK__COOLDOWN_MIN=15

# ── LLM analyst (optional second-opinion layer) ─────────────────────────────
# Any OpenAI-compatible provider: zhipu | openai | deepseek | groq | ollama
# Leave LLM_API_KEY empty to run purely mechanical rules (no feature lost).
LLM_PROVIDER=zhipu
LLM_MODEL=
LLM_API_KEY=
